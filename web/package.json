{
  "name": "print-partner-web",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w @print-partner/contracts && npm run build -w @print-partner/domain",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @print-partner/server\" \"npm run dev -w @print-partner/web\"",
    "build": "npm run build -w @print-partner/contracts && npm run build -w @print-partner/domain && npm run build -w @print-partner/server && npm run build -w @print-partner/web",
    "test": "npm run test:contract-semantics && npm run test:desktop-parity && npm run test:synthetic-dataset && npm run contracts:schemas && npm run test:release && npm run test:build-tools && npm run test -w @print-partner/contracts --if-present && npm run test -w @print-partner/rust-client && npm run test -w @print-partner/domain --if-present && npm run test -w @print-partner/web --if-present && npm run test:ci -w @print-partner/server --if-present",
    "test:release": "node ../scripts/audit-public-release.mjs && node --test ../scripts/release.test.mjs ../scripts/site-map-docs.test.mjs ../scripts/docker-startup.test.mjs",
    "test:build-tools": "node --test scripts/atomic-package-build.test.mjs test/daily-loop/steps.test.mjs",
    "test:runtime": "node --test scripts/server-runtime.test.mjs ../scripts/verify-print-partner/control-print-partner.test.mjs",
    "test:browser": "npm run test:browser -w @print-partner/web",
    "test:e2e": "playwright test",
    "test:daily-loop": "node test/daily-loop/run.mjs",
    "test:workflow-smoke": "python3 -m unittest scripts.test_workflow_smoke",
    "audit:cleanup": "node ../scripts/audit-cleanup.mjs",
    "audit:public": "node ../scripts/audit-public-release.mjs",
    "docs:licenses": "node ../scripts/update-third-party-notices.mjs",
    "lint": "eslint .",
    "format:check": "cd .. && prettier --check --ignore-path .prettierignore \"web/*.{ts,tsx,mts,cts}\" \"web/{apps,packages,scripts}/**/*.{ts,tsx,mts,cts}\"",
    "typecheck": "npm run build -w @print-partner/contracts && npm run build -w @print-partner/domain && npm run typecheck -w @print-partner/server && npm run typecheck -w @print-partner/web && npm run typecheck -w @print-partner/rust-client",
    "quality": "npm run lint && npm run lint:dead && npm run typecheck && npm test && npm run test:workflow-smoke && npm run build && npm run test:bundles -w @print-partner/web && npm run test:runtime && npm run test:browser",
    "db:migrate": "npm run db:migrate -w @print-partner/server",
    "lint:dead": "knip --no-gitignore",
    "fixture:storage:export-data": "node --conditions=development --import tsx scripts/storage-fixtures/export-data.mts",
    "fixture:storage:node-access": "node --conditions=development --import tsx scripts/storage-fixtures/node-access.mts",
    "fixture:storage:prepare": "node --conditions=development --import tsx scripts/storage-fixtures/prepare.mts",
    "test:desktop-parity": "node --conditions=development --import tsx scripts/desktop-parity/verify.mts",
    "fixture:synthetic": "node --conditions=development --import tsx scripts/synthetic-dataset/generate.mts",
    "fixture:synthetic:copy": "node --conditions=development --import tsx scripts/synthetic-dataset/copy.mts",
    "test:synthetic-dataset": "node --conditions=development --import tsx --test scripts/synthetic-dataset/generate.test.mts",
    "contracts:schemas": "node --conditions=development --import tsx scripts/desktop-contracts/schema-check.mjs",
    "contracts:reverse:generate": "node scripts/rust-contracts/run.mjs --write",
    "contracts:reverse:verify": "node scripts/rust-contracts/run.mjs --check",
    "contracts:generate": "node scripts/desktop-contracts/regenerate.mjs",
    "test:contract-semantics": "node --conditions=development --import tsx --test scripts/desktop-contracts/semantics.test.mjs",
    "contracts:verify": "node scripts/desktop-contracts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@print-partner/contracts": "*",
    "ajv": "6.15.0",
    "better-sqlite3": "13.0.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fastify": "5.12.7",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript-eslint": "^8.72.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "find-my-way": "9.7.0",
    "nanoid": "3.3.20",
    "shell-quote": "1.12.0",
    "hono": "4.13.11",
    "postcss": "8.5.29",
    "qs": "6.16.0",
    "@fastify/busboy": "3.2.2",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "@hono/node-server": "2.1.3"
  },
  "description": "Print Partner monorepo: Fastify API + React SPA for layered STL kit work (Library → Builds → Sources → Plan → Production ↔ Checkoff)."
}
