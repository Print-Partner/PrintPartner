{
  "name": "@print-partner/rust-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ../../scripts/rust-contracts/client.mjs --write",
    "check": "node ../../scripts/rust-contracts/client.mjs --check",
    "test": "node ../../scripts/rust-contracts/client.mjs --verify",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "description": "Generated typed requests, responses and Zod schemas for the Rust core's routes."
}
