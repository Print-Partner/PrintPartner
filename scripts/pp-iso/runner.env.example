# Copy to /etc/pp-iso/runner.env. No secret goes in this file: the token is a separate root-only file.
PP_ISO_REPO=poitee/PrintPartner
PP_ISO_IMAGE=localhost/pp-iso-runner:2.338.2
# Per job. A Rust build needs 4 CPUs and about 14 GB; lighter gates need less.
PP_ISO_CPUS=4
PP_ISO_MEMORY=14g
# Number of slots (concurrent jobs) this host runs. install.sh checks it against the host size.
PP_ISO_SLOTS=1
# CPUs and memory the pp-local runners on this host keep for themselves, so pp-iso never starves them.
PP_LOCAL_RESERVE_CPUS=0
PP_LOCAL_RESERVE_MEMORY_GB=0
