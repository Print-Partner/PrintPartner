{
  "name": "@print-partner/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replacement Print Partner UI. Talks only to the Rust core.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node test/browser/font-requests.browser.mjs && node test/browser/frame.browser.mjs"
  },
  "dependencies": {
    "@print-partner/rust-client": "*",
    "@tanstack/react-query": "^5.104.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
