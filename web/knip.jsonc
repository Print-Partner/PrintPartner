{
  "$schema": "https://unpkg.com/knip@6.41.0/schema-jsonc.json",
  "ignoreBinaries": [
    "mkfifo" // FIFO fixtures in server tests
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,mts,ts}",
        "scripts/desktop-parity/verify.mts",
        "scripts/desktop-parity/capture.mts",
        "scripts/desktop-parity/gre487.mts",
        "scripts/desktop-parity/compare.mts"
      ],
      "project": [
        "scripts/**"
      ],
      "ignoreDependencies": [
        "jscpd", // scripts/check-duplication.mjs resolves this CLI from the repo root
        "fflate",
        "@print-partner/domain"
      ]
    },
    "apps/server": {
      "entry": [
        "capture-digest-fixtures.ts",
        "src/**/*.test.ts",
        "src/desktop.ts",
        "src/desktop-resolution.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/*.ts",
        "*.ts"
      ],
      "ignore": [
        "src/db/schema.ts"
      ]
    },
    "apps/ui": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.ts",
        "*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/**/*.test.{ts,tsx}",
        "test/**/*.{mjs,ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**"
      ],
      "ignore": [
        "src/components/ui/**"
      ]
    },
    "packages/contracts": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/domain": {
      "entry": [
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreUnresolved": [
    "../apps/server/dist/current/db/client-postgres.js",
    "../apps/server/dist/current/app.js",
    "../apps/server/dist/current/config.js",
    "../apps/server/dist/current/lib/tenant-disk-quota.js"
  ]
}
