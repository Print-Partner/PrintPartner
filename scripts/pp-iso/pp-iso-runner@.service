[Unit]
Description=pp-iso ephemeral runner slot %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/pp-iso
# install.sh puts the uid of the pp-iso user in place of the uid placeholder below. The slot needs that user's lingering
# runtime directory and a delegated cgroup, so podman can apply --cpus and --memory.
Requires=user@__UID__.service
After=user@__UID__.service

[Service]
User=pp-iso
Group=pp-iso
Delegate=yes
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
EnvironmentFile=/etc/pp-iso/runner.env
# The root-only token file is handed to this service as a credential and is not readable by other users.
LoadCredential=token:/etc/pp-iso/token
RuntimeDirectory=pp-iso-%i
RuntimeDirectoryMode=0700
ExecStart=/usr/local/lib/pp-iso/pp-iso-loop.sh %i
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=90
# Rootless podman needs newuidmap (setuid) and its home directory, so no NoNewPrivileges or ProtectHome here.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
